/target
**/*.rs.bk
*.log

# Local, untracked OAuth client credentials (never commit real secrets)
oauth.toml

# Developer scratch / asset drop-off
/temp

# Generated for the offline Flatpak build (regenerate from Cargo.lock)
cargo-sources.json

# Self-hosted Flatpak distribution (signed repo, private GPG key)
/dist/

# Native package build output (tools/build-packages.sh)
/packaging/out/

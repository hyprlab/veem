# Build environment for the Debian/Ubuntu package (used by tools/build-packages.sh).
# Ubuntu 24.04 LTS is the oldest supported target (glibc 2.39, webkitgtk 6.0) so
# the resulting .deb installs on Ubuntu 24.04+ and Debian 13+.
#   podman build --no-cache -t vireo-deb-builder -f packaging/debian/Containerfile
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential debhelper devscripts ca-certificates curl pkgconf \
        libgtk-4-dev libadwaita-1-dev libwebkitgtk-6.0-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*
# Ubuntu 24.04's rustc is too old for the GTK4 crate stack — use rustup stable.
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH
